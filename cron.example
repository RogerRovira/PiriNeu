# Cron schedule aligned to source rhythms (PLAN.md, Milestone 1).
# Install on the deploy machine with:  crontab -e   (paths need adjusting).
# All times are UTC — run `timedatectl set-timezone UTC` on the box or
# prefix entries with CRON_TZ=UTC where supported.
#
# Optional: export ALERT_WEBHOOK_URL (e.g. an https://ntfy.sh/<topic> URL)
# so failures reach your phone; they always land in data/logs/alerts.log.

PIRINEU=/path/to/PiriNeu

# Open-Meteo/AROME leg — source refreshes hourly.
10 * * * * cd $PIRINEU && python3 openmeteo_ingest.py >> data/logs/cron.log 2>&1

# Silent-failure watchdog — alerts if the newest DB row is older than
# PIRINEU_MAX_AGE_HOURS (default 26 h). A crashed job alerts by itself;
# this catches the job that "succeeds" while storing nothing.
0 8 * * * cd $PIRINEU && python3 healthcheck.py >> data/logs/cron.log 2>&1

# Milestone 2 legs (uncomment when the scripts land):
# Meteocat publishes ~14:00 local (12:00/13:00 UTC depending on DST).
# 30 13 * * * cd $PIRINEU && python3 meteocat_ingest.py >> data/logs/cron.log 2>&1
# AEMET publishes at 00/06/12/18 UTC plus lag (reconnaissance pending).
# 45 1,7,13,19 * * * cd $PIRINEU && python3 aemet_ingest.py >> data/logs/cron.log 2>&1
